# =============================================================================
# Regkasse — LOCAL production-oriented Compose env (before cloud cutover)
# =============================================================================
# Use this to test docker-compose.prod.yml on your machine (localhost URLs).
#
#   copy .env.production.local.example .env.production
#   docker-up-prod.bat
#
# Soft TSE is still FORBIDDEN (Device/Real). Set Fiskaly TEST/prod vendor secrets
# or the API container will exit (TseProductionOptionsValidator).
# Prefer FINANZONLINE_MODE=Test until FON cutover.
#
# Cloud/prod hosts: use .env.production.example with https://api.regkasse.at URLs.
# Docs: docs/DOCKER_PRODUCTION.md · docs/TSE_PRODUCTION_CONFIG_LOCK.md
# =============================================================================

# --- Required ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_prod_docker_change_me
POSTGRES_DB=kasse_prod_local
JWT_SECRET_KEY=local-prod-docker-jwt-secret-key-32c
ADMIN_API_URL=http://127.0.0.1:5184

# --- Image / release ---
IMAGE_TAG=local-prod
RELEASE_STAGE=production

# --- Ports (loopback) ---
POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_HOST_BIND=127.0.0.1
REDIS_INSTANCE_NAME=Regkasse_LocalProd
API_PORT=5184
API_HOST_BIND=127.0.0.1
ADMIN_PORT=3000
ADMIN_HOST_BIND=127.0.0.1
SITES_PORT=3001
SITES_HOST_BIND=127.0.0.1
POS_PORT=8081
POS_HOST_BIND=127.0.0.1

# --- Security (prod-like) ---
JWT_ISSUER=Regkasse
JWT_AUDIENCE=RegkasseClients
TWO_FACTOR_ENABLED=true
CSRF_ENABLED=true

# --- TSE / Fiskaly (REQUIRED for API to stay up) ---
TSE_PROVIDER=fiskaly
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_API_BASE_URL=https://rksv.fiskaly.com/api/v1
FISKALY_SCU_ID=

# --- FinanzOnline (local dry-run: Test until cutover) ---
FINANZONLINE_MODE=Test

# --- Frontend build-time public URLs (localhost for local Docker test) ---
POS_API_URL=http://127.0.0.1:5184/api
ADMIN_PUBLIC_URL=http://127.0.0.1:3000
NEXT_PUBLIC_RKSV_ENVIRONMENT=PROD
