{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "FA monitoring (in-app)",
      "url": "https://admin.regkasse.at/admin/monitoring",
      "type": "link"
    }
  ],
  "panels": [
    {
      "title": "API request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(api_requests_total[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "title": "API error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(api_errors_total[5m])) / clamp_min(sum(rate(api_requests_total[5m])), 0.001)",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "title": "API latency p95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(api_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "title": "Blackbox probes",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-http\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "title": "TSE fleet / FON failures",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "tse_fleet_status",
          "legendFormat": "tse_fleet_status",
          "refId": "A"
        },
        {
          "expr": "sum(rate(finanzonline_submit_failed_total[15m]))",
          "legendFormat": "fon_fail/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(finanzonline_submit_total[15m]))",
          "legendFormat": "fon_submit/s",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Business gauges",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "tenants_active_total", "legendFormat": "tenants", "refId": "A" },
        { "expr": "orders_active_total", "legendFormat": "orders_active", "refId": "B" },
        { "expr": "users_registered_total", "legendFormat": "users", "refId": "C" }
      ]
    },
    {
      "title": "Offline replay",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(replay_total[15m]))", "legendFormat": "replay", "refId": "A" },
        { "expr": "sum(rate(replay_failed_total[15m]))", "legendFormat": "failed", "refId": "B" },
        { "expr": "sum(rate(replay_duplicate_total[15m]))", "legendFormat": "duplicate", "refId": "C" }
      ]
    },
    {
      "title": "Recent container logs (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=~\"backend|frontend-admin|postgres|redis\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["regkasse", "api", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Regkasse API / Fiscal",
  "uid": "regkasse-api-monitoring",
  "version": 1
}
