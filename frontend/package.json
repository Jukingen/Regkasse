{
  "name": "cash-register",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "scripts": {
    "dev": "expo start --max-workers=2",
    "start": "expo start --max-workers=2",
    "start:clean": "expo start --clear --max-workers=2",
    "android": "expo start --android --max-workers=2",
    "ios": "expo start --ios --max-workers=2",
    "web": "expo start --web --max-workers=2",
    "build": "expo export",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:contract": "jest __tests__/paymentService.taxTypeNormalization.test.ts __tests__/normalizePosPaymentMethods.test.ts __tests__/phaseDPaymentRequest.test.ts __tests__/posRegisterPaymentGate.test.ts __tests__/integration/api/payment-integration.test.ts __tests__/contract/pos-payment-contract.test.ts __tests__/paymentService.onlinePayment.test.ts __tests__/parsePaymentResultParams.test.ts __tests__/onlinePaymentStore.test.ts __tests__/onlinePaymentMethods.test.ts __tests__/onlinePaymentService.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "jest --verbose --detectOpenHandles",
    "clean": "expo start --clear --reset-cache",
    "reset": "rm -rf node_modules && npm install && expo start --clear",
    "i18n:export-csv": "node ../localization/scripts/export-translations.mjs --app frontend",
    "i18n:import-csv": "node ../localization/scripts/import-translations.mjs --app frontend",
    "i18n:validate": "node ../localization/scripts/validate-translations.mjs --app frontend",
    "i18n:boundary": "node ../localization/scripts/check-translation-boundary.mjs --app frontend",
    "i18n:usage": "node ../localization/scripts/check-localization-usage.mjs --app frontend",
    "i18n:ci": "node ../localization/scripts/validate-translations.mjs --app frontend --strictMissing true --orphanPolicy error && node ../localization/scripts/check-translation-boundary.mjs --app frontend && node ../localization/scripts/check-localization-usage.mjs --app frontend --strictMissing true --budgetFile ../localization/i18n-ci-budgets.json"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@expo/vector-icons": "^15.0.2",
    "@microsoft/signalr": "^10.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "8.32.0",
    "axios": "^1.20.0",
    "buffer": "^6.0.3",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "i18next": "^26.5.5",
    "intl-pluralrules": "^2.0.1",
    "jwt-decode": "^4.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.2",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-idle-timer-detection": "^1.0.1",
    "react-native-qrcode-svg": "^6.3.27",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-universe": "^16.1.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
