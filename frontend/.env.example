# POS frontend API base URL for Expo public config.
# Native/device beta builds must point to a backend URL reachable from the device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5184/api

# Fiskaly SIGN AT environment for the POS TSE chip (TEST | LIVE).
# TEST shows "TSE aktiv (TEST)". Prefer API GET /api/pos/tse/status `environment`.
EXPO_PUBLIC_ENVIRONMENT=TEST

# Release stage banner fallback (dev | staging | canary | production). Prefer API `/api/rksv/environment`.
EXPO_PUBLIC_RELEASE_STAGE=dev

# Development: tenant slug for X-Tenant-Id and ?tenant= on every API request (__DEV__ only).
# Both are sent together. Header is preferred by the API; query is the documented fallback.
# Must match tenants.slug (seed: dev, prod). Defaults to "dev" when unset in __DEV__.
# EXPO_PUBLIC_DEV_TENANT_ID=dev

# Gutschein offline queue (default false — never store plaintext voucher codes).
# EXPO_PUBLIC_ENABLE_OFFLINE_GUTSCHEIN=false

# Native / Expo Go: localhost is unreachable from a physical device and the Android emulator.
# Use your machine LAN IP, e.g. EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5184/api
# iOS Simulator can keep localhost. The POS shows a development banner when a loopback URL is used on native.

# Optional: artificial HTTP delay in dev only (__DEV__ + non-production NODE_ENV). Metro restart after .env changes.
EXPO_PUBLIC_SIMULATE_NETWORK_DELAY_MS=0

# Offline / TSE / NTP POS simulations (EXPO_PUBLIC_SIMULATE_OFFLINE_MODE, EXPO_PUBLIC_SIMULATE_POS_* , etc.)
# are permanently disabled in app code — do not rely on these env vars; they are ignored.

# Optional: full URL to open when the user taps “Lizenz verlängern” (e.g. FA license page).
# If unset, EXPO_PUBLIC_ADMIN_BASE_URL + /admin/license is used when EXPO_PUBLIC_ADMIN_BASE_URL is set.
# EXPO_PUBLIC_LICENSE_EXTENSION_URL=https://admin.example.com/admin/license

# Optional: admin base URL for license extension (Option B). Trailing slash is optional.
# EXPO_PUBLIC_ADMIN_BASE_URL=https://admin.example.com
