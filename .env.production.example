# =============================================================================
# Regkasse — production Compose environment template
# =============================================================================
# Copy to `.env.production` (gitignored via `.env.*`) and replace every secret:
#
# Local full-stack test (localhost URLs — preferred for docker-up-prod.bat):
#   copy .env.production.local.example .env.production
#   docker-up-prod.bat
#
# Cloud-style hosts:
#   copy .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Do NOT use docker-compose.override.yml with this file (Soft TSE / FON simulation).
#
# Secrets strategy:
#   - Keep `.env.production` only on the host (or inject via Docker/Swarm/K8s secrets)
#   - Prefer a vault / GitHub Environments for CI deploy webhooks — never commit secrets
#   - Rotate JWT_SECRET_KEY and DB password after any leak; invalidate sessions after JWT rotate
#   - Fiskaly keys are vendor secrets — store separately from DB password when possible
#
# Docs: docs/DOCKER_ENV_VARS.md · docs/DOCKER_PRODUCTION.md · DEPLOYMENT.md ·
#       docs/RKSV_PRODUCTION_CUTOVER_CHECKLIST.md · docs/TSE_PRODUCTION_CONFIG_LOCK.md
# =============================================================================

# --- Required (minimum) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=kasse_prod
JWT_SECRET_KEY=CHANGE_ME_min_32_random_chars_xxxxxxxxxxxx
ADMIN_API_URL=https://api.regkasse.at

# --- Image / release ---
IMAGE_TAG=prod
RELEASE_STAGE=production
# DOTNET_RID=linux-x64

# --- Registry push (docker-push-prod.bat / scripts/docker-push-prod.ps1) ---
# Example GHCR: ghcr.io/your-org
# DOCKER_REGISTRY=ghcr.io/your-org
# DOCKER_PUSH_USERNAME=
# Leave password/token out of this file — use `docker login` interactively or CI secrets.

# --- PostgreSQL (ports bound to loopback by default) ---
POSTGRES_PORT=5432
POSTGRES_HOST_BIND=127.0.0.1
# POSTGRES_CPU_LIMIT=2.0
# POSTGRES_MEMORY_LIMIT=2G

# --- Redis ---
REDIS_PORT=6379
REDIS_HOST_BIND=127.0.0.1
REDIS_INSTANCE_NAME=Regkasse_Prod
# REDIS_CPU_LIMIT=1.0
# REDIS_MEMORY_LIMIT=512M

# --- API ---
API_PORT=5184
API_HOST_BIND=127.0.0.1
JWT_ISSUER=Regkasse
JWT_AUDIENCE=RegkasseClients
TWO_FACTOR_ENABLED=true
CSRF_ENABLED=true
# API_CPU_LIMIT=2.0
# API_MEMORY_LIMIT=2G

# --- TSE / Fiskaly (required for real Device/Real signing) ---
# LIVE SCU + keys: docs/FISKALY_PRODUCTION_CUTOVER.md — never commit real values.
TSE_PROVIDER=fiskaly
FISKALY_API_KEY=
FISKALY_API_SECRET=
FISKALY_API_BASE_URL=https://rksv.fiskaly.com/api/v1
FISKALY_SCU_ID=
FISKALY_SIGNING_CERT_DER_B64=
FISKALY_TURNOVER_AES_KEY_B64=

# --- FinanzOnline ---
# Production SOAP needs cutover approval (FinanzOnline:CutoverGuard).
# Prefer FINANZONLINE_MODE=Test until cutover is complete.
FINANZONLINE_MODE=Production

# --- Public URLs (baked into frontend images at build time) ---
POS_API_URL=https://api.regkasse.at/api
ADMIN_PUBLIC_URL=https://admin.regkasse.at
NEXT_PUBLIC_RKSV_ENVIRONMENT=PROD

# --- Optional frontend ports (Compose profiles: admin | sites | pos) ---
ADMIN_PORT=3000
ADMIN_HOST_BIND=127.0.0.1
SITES_PORT=3001
SITES_HOST_BIND=127.0.0.1
POS_PORT=8081
POS_HOST_BIND=127.0.0.1
# ADMIN_CPU_LIMIT=1.0
# ADMIN_MEMORY_LIMIT=1G
# SITES_CPU_LIMIT=1.0
# SITES_MEMORY_LIMIT=768M
# POS_CPU_LIMIT=0.5
# POS_MEMORY_LIMIT=256M

# --- Container log rotation (json-file driver) ---
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5

# --- Optional monitoring stack (monitoring/docker-compose.monitoring.yml) ---
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
# PROMETHEUS_RETENTION=15d
# GRAFANA_PORT=3002
# PROMETHEUS_PORT=9090

