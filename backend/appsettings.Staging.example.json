{
  "Logging": {
    "_comment_cache": "Observation window (~1 week): Caching=Debug so hit/miss (LogDebug) are visible — see docs/CACHE_OPTIMIZATION.md. After analysis set KasseAPI_Final.Services.Caching back to Warning. Information alone does not show hit/miss.",
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "KasseAPI_Final": "Information",
      "KasseAPI_Final.Program": "Warning",
      "KasseAPI_Final.Services.CartLifecycleService": "Warning",
      "KasseAPI_Final.Middleware.MetricsMiddleware": "Warning",
      "KasseAPI_Final.Services.Backup": "Information",
      "KasseAPI_Final.Services.Caching": "Debug"
    }
  },
  "Deployment": {
    "_comment": "Set RELEASE_STAGE=staging (or Deployment__ReleaseStage). See docs/ENVIRONMENT_CONFIGURATION.md",
    "ReleaseStage": "staging",
    "CanaryTenantIds": [],
    "CanaryTenantSlugs": [],
    "CanaryDefaultSoakHours": 24,
    "StatusReportToken": ""
  },
  "Auth": {
    "AllowLegacyLoginWithoutClientApp": false,
    "RequireTenantMembershipForLogin": true,
    "RequireTenantHostMatch": true
  },
  "SessionPolicy": {
    "MaxConcurrentSessions": 1,
    "SessionTimeoutMinutes": 30,
    "AllowMultipleDevices": false
  },
  "CriticalActions": {
    "Enabled": true,
    "BypassInDevelopment": false,
    "ApprovalTokenTtlMinutes": 5,
    "PendingRequestTtlMinutes": 30,
    "SuperAdminMaySelfApprove": true
  },
  "TenantOperationLimits": {
    "Enabled": true,
    "BypassInDevelopment": false,
    "MaxBulkDeletePerDay": 50,
    "MaxPriceUpdatePerHour": 100,
    "MaxProductCreatePerDay": 500,
    "MaxUserCreatePerDay": 20,
    "MaxBackupPerDay": 5,
    "MaxExportPerDay": 10,
    "RequireApprovalForBulkDelete": 500,
    "RequireApprovalForPriceUpdate": 200
  },
  "GracePeriods": {
    "Enabled": true,
    "ExecutorPollSeconds": 30,
    "Schlussbeleg": { "Duration": "00:30:00", "RequiresApproval": true },
    "TenantDeletion": { "Duration": "24:00:00", "RequiresApproval": true },
    "BulkDelete": { "Duration": "01:00:00", "RequiresApproval": false },
    "PriceUpdate": { "Duration": "00:15:00", "RequiresApproval": false },
    "LicenseChange": { "Duration": "02:00:00", "RequiresApproval": true }
  },
  "TwoFactorAuth": {
    "Enabled": true,
    "BypassInDevelopment": false,
    "TestToken": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Limit": 120,
    "WindowSeconds": 60
  },
  "AccountLockout": {
    "Enabled": true,
    "MaxAttempts": 5,
    "LockoutMinutes": 15
  },
  "RKSV": {
    "_comment": "Ideal for demo and staging: mirrors Production fiscal posture, but ShowDemoLabel keeps a clear visual indicator so demos are not confused with live production.",
    "Mode": "Production",
    "TseMode": "Real",
    "FinanzOnlineMode": "Real",
    "ShowDemoLabel": true
  },
  "Tse": {
    "_comment": "Same lock as Production when EnforceProductionLockInStaging=true (default).",
    "TseMode": "Device",
    "Mode": "Real",
    "Environment": "Test",
    "Provider": "fiskaly",
    "AllowUnsafeFiscalModesInProduction": false,
    "EnforceProductionLockInStaging": true,
    "FallbackEnabled": false,
    "SoftTseEnabled": false,
    "AutoProvisionOnTenantCreate": true,
    "Providers": {
      "fiskaly": {
        "Enabled": true,
        "ApiBaseUrl": "https://rksv.fiskaly.com/api/v1",
        "ApiKey": "",
        "ApiSecret": "",
        "SignatureCreationUnitId": ""
      },
      "epson": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      },
      "swissbit": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      }
    }
  },
  "FinanzOnline": {
    "_comment": "Use BMF TEST endpoints / credentials in Staging — never Production Soft TSE. Secrets via env/vault.",
    "Mode": "Production",
    "Session": {
      "UseSimulation": false
    },
    "Registrierkassen": {
      "UseSimulation": false
    },
    "TransmissionQuery": {
      "UseSimulation": false
    },
    "RksvSubmission": {
      "ClientKind": "Real",
      "Enabled": true,
      "AllowOutboundNetworkCalls": true,
      "AllowFakeClientInProduction": false,
      "TimeoutSeconds": 120
    }
  },
  "FinanzOnlineOutbox": {
    "Enabled": true
  },
  "FinanzOnlineRetryJob": {
    "Enabled": true
  },
  "Backup": {
    "ExecutionAdapterKind": "PgDump",
    "ArtifactStagingRoot": "/var/backups/regkasse-staging/staging",
    "ExternalArchiveRoot": "/var/backups/regkasse-staging/archive",
    "ExternalArchiveMutableTargetAccepted": true,
    "PgDumpExecutablePath": "/usr/bin/pg_dump",
    "LogicalDumpConnectionStringName": "DefaultConnection",
    "WorkerEnabled": true,
    "AcknowledgePhase1NoRealBackup": false,
    "ScheduledBackupEnabled": true,
    "ScheduledBackupCron": "0 3 * * *",
    "ArtifactRetentionDays": 14
  },
  "JwtSettings": {
    "Issuer": "KasseAPI-Staging",
    "Audience": "KasseAPIUsers-Staging",
    "ExpirationHours": 24,
    "MaxTokenSizeBytes": 3500
  },
  "Cors": {
    "AllowedOrigins": [
      "https://admin.staging.regkasse.at",
      "https://pos.staging.regkasse.at",
      "https://staging.regkasse.at"
    ]
  },
  "AllowedHosts": "api.staging.regkasse.at;admin.staging.regkasse.at;pos.staging.regkasse.at;*.staging.regkasse.at",
  "Redis": {
    "Enabled": true,
    "ConnectionString": "redis-cluster:6379",
    "InstanceName": "Regkasse_Staging"
  },
  "CacheSettings": {
    "_comment": "Staging TTLs after CACHE_OPTIMIZATION pass (2026-08): permissions 60m (event-invalidated); products 30m; license stays 5m for SaaS freshness; tenant settings 90m. See docs/CACHE_OPTIMIZATION.md.",
    "LicenseCacheMinutes": 5,
    "ProductCacheMinutes": 30,
    "PermissionCacheMinutes": 60,
    "TenantSettingsCacheMinutes": 90,
    "TenantLimitsCacheMinutes": 5,
    "TseHealthCacheSeconds": 30
  },
  "Security": {
    "Csrf": {
      "Enabled": true,
      "BypassInDevelopment": false,
      "HeaderName": "X-XSRF-TOKEN",
      "CookieName": "XSRF-TOKEN",
      "TokenLifetimeHours": 24
    }
  },
  "Billing": {
    "ReminderDaysBeforeExpiry": [30, 15, 7, 3, 1],
    "ReminderCheckHourUtc": 9,
    "ReminderCheckMinuteUtc": 0,
    "AutoMonthlyInvoicingEnabled": true,
    "SkipPrepaidTenants": true,
    "SkipTrialTenants": true
  },
  "Email": {
    "_comment": "Staging: prefer DevCapture for safe testing; set Smtp Host/User/Password via env/vault for real delivery.",
    "DevCapture": {
      "Enabled": true,
      "Directory": "App_Data/dev-mail"
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "User": "",
      "Password": "",
      "From": "noreply@regkasse.at",
      "SupportContact": "support@regkasse.at",
      "LicenseReminderRecipients": "",
      "LicenseReportRecipients": ""
    }
  },
  "Monitoring": {
    "Enabled": true,
    "MetricsEndpoint": "/metrics",
    "SlowRequestThresholdMs": 1000,
    "Prometheus": {
      "Enabled": true,
      "ScrapeIntervalSeconds": 15
    }
  },
  "Fiskaly": {
    "Enabled": true,
    "ApiKey": "",
    "ApiSecret": "",
    "TseSerialNumber": "",
    "ScuId": "",
    "ApiBaseUrl": "https://rksv.fiskaly.com/api/v1",
    "Environment": "TEST",
    "TokenCacheMinutes": 1380,
    "MaxRetries": 3,
    "RetryDelaySeconds": 2
  }
}
