{
  "Deployment": {
    "_comment": "production | canary. CanaryTenantIds/Slugs → CANARY banner for those tenants only. Env: RELEASE_STAGE. StatusReportToken for CI dashboard.",
    "ReleaseStage": "production",
    "CanaryTenantIds": [],
    "CanaryTenantSlugs": [],
    "CanaryDefaultSoakHours": 24,
    "StatusReportToken": "",
    "RollbackWebhooks": {
      "staging": "",
      "canary": "",
      "production": ""
    },
    "CanaryMonitor": {
      "Enabled": true,
      "CheckIntervalMinutes": 15,
      "WindowMinutes": 60,
      "ErrorCountThreshold": 10,
      "ErrorRateThresholdPercent": 5.0,
      "MinEventsForRate": 20
    }
  },
  "GoLive": {
    "_comment": "Fail-closed. Set true only after host evidence + named signatures on docs/GO_LIVE_CHECKLIST.md §8.",
    "AlertmanagerReceiversConfigured": false,
    "AvvSignedForPilots": false,
    "OnCallNamed": false,
    "Section8Signed": false
  },
  "Auth": {
    "AllowLegacyLoginWithoutClientApp": false,
    "RequireTenantMembershipForLogin": true,
    "RequireTenantHostMatch": true
  },
  "AuthCookies": {
    "Enabled": true,
    "Domain": ".regkasse.at",
    "SameSite": "Lax",
    "Secure": true
  },
  "SessionPolicy": {
    "MaxConcurrentSessions": 1,
    "SessionTimeoutMinutes": 30,
    "AllowMultipleDevices": false
  },
  "DownloadSecurity": {
    "MaxDownloadsPerUserPerDay": 50,
    "MaxFileSizeBytes": 2147483648,
    "DownloadLinkTtlHours": 24,
    "RequireApprovalForSensitiveExports": true,
    "RequireTwoFactorForCriticalExports": false,
    "SuperAdminMaySelfApprove": true
  },
  "CriticalActions": {
    "Enabled": false,
    "BypassInDevelopment": false,
    "ApprovalTokenTtlMinutes": 5,
    "PendingRequestTtlMinutes": 30,
    "SuperAdminMaySelfApprove": true
  },
  "TenantOperationLimits": {
    "Enabled": true,
    "BypassInDevelopment": false,
    "MaxBulkDeletePerDay": 50,
    "MaxPriceUpdatePerHour": 100,
    "MaxProductCreatePerDay": 500,
    "MaxUserCreatePerDay": 20,
    "MaxBackupPerDay": 5,
    "MaxExportPerDay": 10,
    "RequireApprovalForBulkDelete": 500,
    "RequireApprovalForPriceUpdate": 200
  },
  "GracePeriods": {
    "Enabled": true,
    "ExecutorPollSeconds": 30,
    "Schlussbeleg": { "Duration": "00:30:00", "RequiresApproval": true },
    "TenantDeletion": { "Duration": "24:00:00", "RequiresApproval": true },
    "BulkDelete": { "Duration": "01:00:00", "RequiresApproval": false },
    "PriceUpdate": { "Duration": "00:15:00", "RequiresApproval": false },
    "LicenseChange": { "Duration": "02:00:00", "RequiresApproval": true }
  },
  "TwoFactorAuth": {
    "Enabled": true,
    "BypassInDevelopment": false,
    "TestToken": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Limit": 100,
    "WindowSeconds": 60
  },
  "AccountLockout": {
    "Enabled": true,
    "MaxAttempts": 5,
    "LockoutMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "KasseAPI_Final": "Information",
      "KasseAPI_Final.Program": "Warning",
      "KasseAPI_Final.Services.CartLifecycleService": "Warning",
      "KasseAPI_Final.Middleware.MetricsMiddleware": "Warning",
      "KasseAPI_Final.Services.Backup": "Information",
      "KasseAPI_Final.Services.Caching": "Warning"
    },
    "Console": {
      "_comment": "JSON console for Promtail/Loki/ELK — see docs/MONITORING.md",
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "Monitoring": {
    "Enabled": true,
    "MetricsEndpoint": "/metrics",
    "SlowRequestThresholdMs": 1000,
    "Prometheus": {
      "Enabled": true,
      "ScrapeIntervalSeconds": 15,
      "AllowedCidrs": []
    }
  },
  "Company": {
    "_comment": "Optional report fallback. POS receipts use tenant company_settings (FA /settings/company). Fill only in untracked appsettings.Production.json — never commit a real UID.",
    "Name": "",
    "Address": "",
    "VatId": "",
    "Phone": "",
    "Email": "",
    "Website": ""
  },
  "CompanyProfile": {
    "_comment": "Do not leave ATU00000000 in Production. Receipt UID comes from company_settings.CompanyTaxNumber.",
    "CompanyName": "",
    "TaxNumber": "",
    "Street": "",
    "ZipCode": "",
    "City": "",
    "Country": "AT"
  },
  "RKSV": {
    "_comment": "Production fiscal defaults — fail-closed if Soft TSE / FON simulation. See docs/ENVIRONMENT_CONFIGURATION.md",
    "Mode": "Production",
    "TseMode": "Real",
    "FinanzOnlineMode": "Real",
    "ShowDemoLabel": false
  },
  "Tse": {
    "_comment": "TseMode=Device, Mode=Real, Provider=fiskaly|epson|swissbit required. Soft/Demo/Fake rejected at startup. Keep Providers:fiskaly in sync with the Fiskaly section (LIVE keys + same SIGN AT URL).",
    "TseMode": "Device",
    "Mode": "Real",
    "Environment": "Production",
    "Provider": "fiskaly",
    "AllowUnsafeFiscalModesInProduction": false,
    "EnforceProductionLockInStaging": true,
    "FallbackEnabled": false,
    "SoftTseEnabled": false,
    "AutoProvisionOnTenantCreate": true,
    "Providers": {
      "fiskaly": {
        "Enabled": true,
        "ApiBaseUrl": "https://rksv.fiskaly.com/api/v1",
        "ApiKey": "",
        "ApiSecret": "",
        "SignatureCreationUnitId": ""
      },
      "epson": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      },
      "swissbit": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      }
    }
  },
  "Fiskaly": {
    "_comment": "SIGN AT (Austria) host is rksv.fiskaly.com. LIVE vs TEST is the Fiskaly organization + API keys, not api.fiskaly.com. Fill secrets only in untracked appsettings.Production.json. Must match Tse:Providers:fiskaly. See docs/FISKALY_PRODUCTION_CUTOVER.md.",
    "Enabled": true,
    "ApiKey": "",
    "ApiSecret": "",
    "TseSerialNumber": "",
    "ScuId": "",
    "ApiBaseUrl": "https://rksv.fiskaly.com/api/v1",
    "Environment": "LIVE",
    "SigningCertificateDerBase64": "",
    "TurnoverCounterAesKeyBase64": "",
    "TokenCacheMinutes": 1380,
    "MaxRetries": 3,
    "RetryDelaySeconds": 2
  },
  "FinanzOnline": {
    "_comment": "All UseSimulation flags must be false in Production (startup + /health/ready). Super Admin FA can still manage retry-job timing; simulation and real TEST SOAP stay forced off. Required for real SOAP: Session:BaseUrl, Registrierkassen:BaseUrl, and Session:DefaultCredential Username/Password (plus TelematikId/HerstellerId) — set credentials via env/vault (FinanzOnline__Session__DefaultCredential__*), never in git. Alternative: Connectivity:UseCompanySettings=true and complete company_settings FON columns.",
    "Mode": "Production",
    "Session": {
      "UseSimulation": false,
      "BaseUrl": "https://finanzonline.bmf.gv.at/fonws/ws/session",
      "DefaultCredential": {
        "Username": "",
        "Password": "",
        "TelematikId": "",
        "HerstellerId": ""
      }
    },
    "Registrierkassen": {
      "UseSimulation": false,
      "BaseUrl": "https://finanzonline.bmf.gv.at/fonws/ws/rkdb"
    },
    "TransmissionQuery": {
      "UseSimulation": false
    },
    "RksvSubmission": {
      "ClientKind": "Real",
      "Enabled": true,
      "AllowOutboundNetworkCalls": true,
      "AllowFakeClientInProduction": false,
      "EndpointUrl": "https://finanzonline.bmf.gv.at/fonws/ws/rkdb",
      "TimeoutSeconds": 120,
      "ParticipantCredentialsConfigurationKey": "FinanzOnline:Participant",
      "ClientCertificateSecretName": null
    }
  },
  "FinanzOnlineOutbox": {
    "_comment": "Deployment default. Must stay true. Super Admin FA snapshot replaces these worker settings at runtime until reset to this default.",
    "Enabled": true
  },
  "FinanzOnlineRetryJob": {
    "Enabled": true
  },
  "Elmah": {
    "ApplicationName": "Regkasse",
    "LogLevel": "Error",
    "MaxLogEntries": 5000,
    "RetentionCheckIntervalMinutes": 60
  },
  "Backup": {
    "_comment": "Linux production defaults. Do not commit real machine secrets here — copy to untracked appsettings.Production.json or set env vars (Backup__*).",
    "_commentWindows": "For Windows production hosts, use: PgDumpExecutablePath=C:\\\\Program Files\\\\PostgreSQL\\\\18\\\\bin\\\\pg_dump.exe ; ArtifactStagingRoot=C:\\\\Regkasse\\\\Backups\\\\Staging ; ExternalArchiveRoot=C:\\\\Regkasse\\\\Backups\\\\Archive (or C:\\\\data\\\\regkasse-backup-*).",
    "ExecutionAdapterKind": "PgDump",
    "PgDumpExecutablePath": "/usr/bin/pg_dump",
    "VerifyLogicalDumpFileOnDisk": true,
    "PgDumpTimeoutSeconds": 7200,
    "LogicalDumpConnectionStringName": "DefaultConnection",
    "ArtifactStagingRoot": "/var/backups/regkasse/staging",
    "ExternalArchiveRoot": "/var/backups/regkasse/archive",
    "StorageTierManagementEnabled": true,
    "StorageCostAlertEurPerMonth": 25,
    "CloudStorage": {
      "Provider": "Filesystem",
      "FallbackToFilesystemWhenUnconfigured": true
    },
    "ExternalArchiveMutableTargetAccepted": true,
    "AcknowledgePhase1NoRealBackup": false,
    "AcknowledgeFakeBackupAdapterOutsideDevelopment": false,
    "ScheduledBackupEnabled": true,
    "ScheduledBackupCron": "0 2 * * *",
    "RetentionPolicyMode": "ReportOnly",
    "ArtifactRetentionDays": 30,
    "WorkerEnabled": true,
    "PitrWalArchivingDeclaredEnabled": false,
    "WalArchiveDirectory": "/var/lib/postgresql/wal-archive",
    "WalArchiveRetentionDays": 7,
    "WalArchiveSwitchIntervalMinutes": 5,
    "IncrementalBackupEnabled": false,
    "IncrementalBackupCron": "0 3 * * *",
    "RpoOverdueAlertEnabled": true,
    "AlertOnNoBackupDays": 2,
    "RpoOverdueAlertMinInterval": "12:00:00",
    "RpoOverdueAlertCheckInterval": "06:00:00",
    "FailureAlertEmailRecipients": "ops@regkasse.at",
    "EncryptionEnabled": false,
    "EncryptionKeyBase64": "",
    "_commentEncryption": "Set EncryptionEnabled=true only with a 32-byte EncryptionKeyBase64 in the secret store. Encrypted files start with RKBAK1 (not PGDMP); decrypt before pg_restore."
  },
  "BackupReVerification": {
    "_comment": "Periodic on-disk SHA-256 re-hash of recent succeeded backups (integrity only).",
    "Enabled": true,
    "CheckIntervalHours": 24,
    "RetentionDays": 7,
    "MaxRunsPerTick": 20
  },
  "Email": {
    "_comment": "Required for backup-failure mail. Set Host/From (and User/Password) via env or untracked Production.json. DevCapture must stay off in Production.",
    "DevCapture": {
      "Enabled": false
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "User": "",
      "Password": "",
      "From": "noreply@regkasse.at",
      "SupportContact": "support@regkasse.at"
    }
  },
  "OperationalDr": {
    "Alerts": {
      "_comment": "Optional HTTP webhook for BackupFailed / VerificationFailed / RpoOverdue / Succeeded. Empty URL = no-op.",
      "WebhookEnabled": false,
      "WebhookUrl": "",
      "WebhookTimeoutSeconds": 15,
      "WebhookSecretHeaderName": "",
      "WebhookSecretHeaderValue": ""
    }
  },
  "RestoreVerification": {
    "_comment": "Isolated clone only — never point IsolatedRestoreAdmin or FiscalValidation at Production DefaultConnection. Requires ConnectionStrings:RestoreAdmin (postgres maintenance DB, CREATEDB).",
    "WorkerEnabled": true,
    "ScheduledWeeklyDrillEnabled": true,
    "IsolatedPgRestoreEnabled": true,
    "IsolatedRestoreAdminConnectionStringName": "RestoreAdmin",
    "PgRestoreExecutablePath": "/usr/bin/pg_restore",
    "FiscalValidationScriptRelativePath": "../scripts/sql/fiscal_go_live_validation.sql",
    "FiscalValidationConnectionStringName": null,
    "IncludeLiveIntegrityChecks": false,
    "AllowNonPgDumpBackupSource": false,
    "PostRestoreSqlChecksEnabled": true,
    "ApplicationSmokeProbeEnabled": false
  },
  "PaymentGateway": {
    "_comment": "Mock is rejected at Production startup. Use Stripe for card intents, or None for cash-only.",
    "Provider": "None",
    "RequireCardIntentForPosPayments": false
  },
  "JwtSettings": {
    "Issuer": "KasseAPI",
    "Audience": "KasseAPIUsers",
    "ExpirationHours": 24,
    "MaxTokenSizeBytes": 3500
  },
  "Cors": {
    "AllowedOrigins": [
      "https://pos.regkasse.at",
      "https://admin.regkasse.at",
      "https://www.regkasse.at"
    ]
  },
  "AllowedHosts": "api.regkasse.at;admin.regkasse.at;pos.regkasse.at;regkasse.at;*.regkasse.at",
  "AutoTagesabschluss": {
    "Enabled": true,
    "DefaultHourVienna": 3,
    "DefaultMinuteVienna": 0,
    "CheckIntervalMinutes": 15
  },
  "Redis": {
    "_comment": "Required in Production for domain ICacheService. Ready probe pings health_check_ping (≤1s); failure → Degraded redisStatus, not Unhealthy.",
    "Enabled": true,
    "ConnectionString": "redis-cluster:6379",
    "InstanceName": "Regkasse_Prod"
  },
  "CacheSettings": {
    "LicenseCacheMinutes": 5,
    "ProductCacheMinutes": 15,
    "PermissionCacheMinutes": 30,
    "TenantSettingsCacheMinutes": 60,
    "TenantLimitsCacheMinutes": 5,
    "TseHealthCacheSeconds": 30
  },
  "Security": {
    "Csrf": {
      "Enabled": true,
      "BypassInDevelopment": false,
      "HeaderName": "X-XSRF-TOKEN",
      "CookieName": "XSRF-TOKEN",
      "TokenLifetimeHours": 24
    }
  }
