{
  "Deployment": {
    "_comment": "production | canary. CanaryTenantIds/Slugs → CANARY banner for those tenants only. Env: RELEASE_STAGE. StatusReportToken for CI dashboard.",
    "ReleaseStage": "production",
    "CanaryTenantIds": [],
    "CanaryTenantSlugs": [],
    "CanaryDefaultSoakHours": 24,
    "StatusReportToken": "",
    "RollbackWebhooks": {
      "staging": "",
      "canary": "",
      "production": ""
    },
    "CanaryMonitor": {
      "Enabled": true,
      "CheckIntervalMinutes": 15,
      "WindowMinutes": 60,
      "ErrorCountThreshold": 10,
      "ErrorRateThresholdPercent": 5.0,
      "MinEventsForRate": 20
    }
  },
  "Auth": {
    "AllowLegacyLoginWithoutClientApp": false,
    "RequireTenantMembershipForLogin": true
  },
  "SessionPolicy": {
    "MaxConcurrentSessions": 1,
    "SessionTimeoutMinutes": 30,
    "AllowMultipleDevices": false
  },
  "DownloadSecurity": {
    "MaxDownloadsPerUserPerDay": 50,
    "MaxFileSizeBytes": 2147483648,
    "DownloadLinkTtlHours": 24,
    "RequireApprovalForSensitiveExports": true,
    "RequireTwoFactorForCriticalExports": false,
    "SuperAdminMaySelfApprove": true
  },
  "CriticalActions": {
    "Enabled": false,
    "BypassInDevelopment": false,
    "ApprovalTokenTtlMinutes": 5,
    "PendingRequestTtlMinutes": 30,
    "SuperAdminMaySelfApprove": true
  },
  "TenantOperationLimits": {
    "Enabled": true,
    "BypassInDevelopment": false,
    "MaxBulkDeletePerDay": 50,
    "MaxPriceUpdatePerHour": 100,
    "MaxProductCreatePerDay": 500,
    "MaxUserCreatePerDay": 20,
    "MaxBackupPerDay": 5,
    "MaxExportPerDay": 10,
    "RequireApprovalForBulkDelete": 500,
    "RequireApprovalForPriceUpdate": 200
  },
  "GracePeriods": {
    "Enabled": true,
    "ExecutorPollSeconds": 30,
    "Schlussbeleg": { "Duration": "00:30:00", "RequiresApproval": true },
    "TenantDeletion": { "Duration": "24:00:00", "RequiresApproval": true },
    "BulkDelete": { "Duration": "01:00:00", "RequiresApproval": false },
    "PriceUpdate": { "Duration": "00:15:00", "RequiresApproval": false },
    "LicenseChange": { "Duration": "02:00:00", "RequiresApproval": true }
  },
  "TwoFactorAuth": {
    "Enabled": true,
    "BypassInDevelopment": false,
    "TestToken": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "Limit": 100,
    "WindowSeconds": 60
  },
  "AccountLockout": {
    "Enabled": true,
    "MaxAttempts": 5,
    "LockoutMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "KasseAPI_Final": "Information",
      "KasseAPI_Final.Program": "Warning",
      "KasseAPI_Final.Services.CartLifecycleService": "Warning",
      "KasseAPI_Final.Middleware.MetricsMiddleware": "Warning",
      "KasseAPI_Final.Services.Backup": "Information",
      "KasseAPI_Final.Services.Caching": "Warning"
    },
    "Console": {
      "_comment": "JSON console for Promtail/Loki/ELK — see docs/MONITORING.md",
      "FormatterName": "json",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "O",
        "JsonWriterOptions": {
          "Indented": false
        }
      }
    }
  },
  "Monitoring": {
    "Enabled": true,
    "MetricsEndpoint": "/metrics",
    "SlowRequestThresholdMs": 1000,
    "Prometheus": {
      "Enabled": true,
      "ScrapeIntervalSeconds": 15
    }
  },
  "RKSV": {
    "_comment": "Production fiscal defaults — fail-closed if Soft TSE / FON simulation. See docs/ENVIRONMENT_CONFIGURATION.md",
    "Mode": "Production",
    "TseMode": "Real",
    "FinanzOnlineMode": "Real",
    "ShowDemoLabel": false
  },
  "Tse": {
    "_comment": "TseMode=Device, Mode=Real, Provider=fiskaly|epson|swissbit required. Soft/Demo/Fake rejected at startup.",
    "TseMode": "Device",
    "Mode": "Real",
    "Environment": "Production",
    "Provider": "fiskaly",
    "AllowUnsafeFiscalModesInProduction": false,
    "EnforceProductionLockInStaging": true,
    "AutoProvisionOnTenantCreate": true,
    "Providers": {
      "fiskaly": {
        "Enabled": true,
        "ApiBaseUrl": "https://rksv.fiskaly.com/api/v1",
        "ApiKey": "",
        "ApiSecret": "",
        "SignatureCreationUnitId": ""
      },
      "epson": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      },
      "swissbit": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      }
    }
  },
  "Fiskaly": {
    "ApiKey": "",
    "ApiSecret": "",
    "TseSerialNumber": "",
    "ApiBaseUrl": "https://api.fiskaly.com/v1"
  },
  "FinanzOnline": {
    "_comment": "All UseSimulation flags must be false in Production (startup + /health/ready).",
    "Mode": "Production",
    "Session": {
      "UseSimulation": false,
      "BaseUrl": "https://finanzonline.bmf.gv.at/fonws/ws/session"
    },
    "Registrierkassen": {
      "UseSimulation": false
    },
    "TransmissionQuery": {
      "UseSimulation": false
    },
    "RksvSubmission": {
      "ClientKind": "Real",
      "Enabled": true,
      "AllowOutboundNetworkCalls": true,
      "AllowFakeClientInProduction": false,
      "EndpointUrl": "https://finanzonline.bmf.gv.at/fonws/ws/rkdb",
      "TimeoutSeconds": 120,
      "ParticipantCredentialsConfigurationKey": "FinanzOnline:Participant",
      "ClientCertificateSecretName": null
    }
  },
  "FinanzOnlineOutbox": {
    "Enabled": true
  },
  "FinanzOnlineRetryJob": {
    "Enabled": true
  },
  "Elmah": {
    "ApplicationName": "Regkasse",
    "LogLevel": "Error",
    "MaxLogEntries": 5000,
    "RetentionCheckIntervalMinutes": 60
  },
  "Backup": {
    "_comment": "Linux production defaults. Do not commit real machine secrets here — copy to untracked appsettings.Production.json or set env vars (Backup__*).",
    "_commentWindows": "For Windows production hosts, use: PgDumpExecutablePath=C:\\\\Program Files\\\\PostgreSQL\\\\18\\\\bin\\\\pg_dump.exe ; ArtifactStagingRoot=C:\\\\Regkasse\\\\Backups\\\\Staging ; ExternalArchiveRoot=C:\\\\Regkasse\\\\Backups\\\\Archive (or C:\\\\data\\\\regkasse-backup-*).",
    "ExecutionAdapterKind": "PgDump",
    "PgDumpExecutablePath": "/usr/bin/pg_dump",
    "VerifyLogicalDumpFileOnDisk": true,
    "PgDumpTimeoutSeconds": 7200,
    "LogicalDumpConnectionStringName": "DefaultConnection",
    "ArtifactStagingRoot": "/var/backups/regkasse/staging",
    "ExternalArchiveRoot": "/var/backups/regkasse/archive",
    "ExternalArchiveMutableTargetAccepted": true,
    "AcknowledgePhase1NoRealBackup": false,
    "AcknowledgeFakeBackupAdapterOutsideDevelopment": false,
    "ScheduledBackupEnabled": true,
    "ScheduledBackupCron": "0 2 * * *",
    "RetentionPolicyMode": "ReportOnly",
    "ArtifactRetentionDays": 30,
    "WorkerEnabled": true,
    "RpoOverdueAlertEnabled": true,
    "AlertOnNoBackupDays": 2,
    "RpoOverdueAlertMinInterval": "12:00:00",
    "RpoOverdueAlertCheckInterval": "06:00:00"
  },
  "BackupReVerification": {
    "_comment": "Periodic on-disk SHA-256 re-hash of recent succeeded backups (integrity only).",
    "Enabled": true,
    "CheckIntervalHours": 24,
    "RetentionDays": 7,
    "MaxRunsPerTick": 20
  },
  "JwtSettings": {
    "Issuer": "KasseAPI",
    "Audience": "KasseAPIUsers",
    "ExpirationHours": 24
  },
  "Cors": {
    "AllowedOrigins": [
      "https://pos.regkasse.at",
      "https://admin.regkasse.at",
      "https://www.regkasse.at"
    ]
  },
  "AllowedHosts": "api.regkasse.at;admin.regkasse.at;pos.regkasse.at;regkasse.at;*.regkasse.at",
  "Redis": {
    "_comment": "Required in Production for domain ICacheService. Ready probe pings health_check_ping (≤1s); failure → Degraded redisStatus, not Unhealthy.",
    "Enabled": true,
    "ConnectionString": "redis-cluster:6379",
    "InstanceName": "Regkasse_Prod"
  },
  "CacheSettings": {
    "LicenseCacheMinutes": 5,
    "ProductCacheMinutes": 15,
    "PermissionCacheMinutes": 30,
    "TenantSettingsCacheMinutes": 60,
    "TseHealthCacheSeconds": 30
  },
  "Security": {
    "Csrf": {
      "Enabled": true,
      "BypassInDevelopment": false,
      "HeaderName": "X-XSRF-TOKEN",
      "CookieName": "XSRF-TOKEN",
      "TokenLifetimeHours": 24
    }
  }
}
