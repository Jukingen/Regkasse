{
  "Urls": "http://localhost:5184",
  "Deployment": {
    "_comment": "Or set RELEASE_STAGE=dev. See docs/ENVIRONMENT_CONFIGURATION.md",
    "ReleaseStage": "dev",
    "CanaryTenantIds": [],
    "CanaryTenantSlugs": []
  },
  "FeatureFlags": {
    "_comment": "All false by default. See docs/FEATURE_FLAGS.md",
    "EnableNewPaymentFlow": false,
    "EnableDepExportV2": false,
    "EnableOnlineOrdersV2": false,
    "EnableAutoAusfall": false
  },
  "Logging": {
    "_comment_cache": "Cache hit/miss are Debug in RedisCacheService. Set KasseAPI_Final.Services.Caching to Debug to see them; Information still surfaces Error-level Redis failures.",
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "KasseAPI_Final": "Information",
      "KasseAPI_Final.Program": "Warning",
      "KasseAPI_Final.Services.CartLifecycleService": "Warning",
      "KasseAPI_Final.Middleware.MetricsMiddleware": "Information",
      "KasseAPI_Final.Services.LicenseService": "Error",
      "KasseAPI_Final.Services.Backup": "Information",
      "KasseAPI_Final.Services.Caching": "Information"
    },
    "Console": {
      "_comment": "Readable single-line console for local Dev. Production uses FormatterName=json — see appsettings.Production.example.json",
      "FormatterName": "readable",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss",
        "SingleLine": true
      }
    }
  },
  "Auth": {
    "AllowLegacyLoginWithoutClientApp": false,
    "RequireTenantMembershipForLogin": false,
    "RequireTenantHostMatch": false
  },
  "SessionPolicy": {
    "MaxConcurrentSessions": 1,
    "SessionTimeoutMinutes": 30,
    "AllowMultipleDevices": false
  },
  "DownloadHistory": {
    "RetentionDays": 30,
    "CleanupIntervalMinutes": 1440,
    "CleanupEnabled": true
  },
  "DownloadSecurity": {
    "MaxDownloadsPerUserPerDay": 50,
    "MaxFileSizeBytes": 2147483648,
    "DownloadLinkTtlHours": 24,
    "RequireApprovalForSensitiveExports": true,
    "RequireTwoFactorForCriticalExports": false,
    "SuperAdminMaySelfApprove": true
  },
  "CriticalActions": {
    "Enabled": false,
    "BypassInDevelopment": true,
    "ApprovalTokenTtlMinutes": 5,
    "PendingRequestTtlMinutes": 30,
    "SuperAdminMaySelfApprove": true
  },
  "TenantOperationLimits": {
    "Enabled": false,
    "BypassInDevelopment": true,
    "MaxBulkDeletePerDay": 50,
    "MaxPriceUpdatePerHour": 100,
    "MaxProductCreatePerDay": 500,
    "MaxUserCreatePerDay": 20,
    "MaxBackupPerDay": 5,
    "MaxExportPerDay": 10,
    "RequireApprovalForBulkDelete": 500,
    "RequireApprovalForPriceUpdate": 200
  },
  "GracePeriods": {
    "Enabled": false,
    "ExecutorPollSeconds": 30,
    "Schlussbeleg": { "Duration": "00:30:00", "RequiresApproval": true },
    "TenantDeletion": { "Duration": "24:00:00", "RequiresApproval": true },
    "BulkDelete": { "Duration": "01:00:00", "RequiresApproval": false },
    "PriceUpdate": { "Duration": "00:15:00", "RequiresApproval": false },
    "LicenseChange": { "Duration": "02:00:00", "RequiresApproval": true }
  },
  "TwoFactorAuth": {
    "Enabled": false,
    "BypassInDevelopment": true,
    "TestToken": "123456"
  },
  "Security": {
    "Csrf": {
      "Enabled": false,
      "BypassInDevelopment": true,
      "HeaderName": "X-XSRF-TOKEN",
      "CookieName": "XSRF-TOKEN",
      "TokenLifetimeHours": 24
    }
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "InstanceName": "Regkasse_Dev"
  },
  "CacheSettings": {
    "LicenseCacheMinutes": 5,
    "ProductCacheMinutes": 10,
    "PermissionCacheMinutes": 15,
    "TenantSettingsCacheMinutes": 30,
    "TseHealthCacheSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://admin.regkasse.local:3000",
      "http://localhost:8081"
    ]
  },
  "RKSV": {
    "_comment": "Development fiscal defaults — Soft TSE / Demo. See docs/ENVIRONMENT_CONFIGURATION.md",
    "Mode": "Demo",
    "TseMode": "Simulation",
    "FinanzOnlineMode": "Simulation",
    "ShowDemoLabel": true
  },
  "Tse": {
    "_comment": "Soft TSE allowed only in Development. Production requires TseMode=Device + real Provider.",
    "TseMode": "Demo",
    "Mode": "Fake",
    "Environment": "Test",
    "Provider": "fake",
    "AutoProvisionOnTenantCreate": true,
    "Providers": {
      "fiskaly": {
        "Enabled": false,
        "ApiBaseUrl": "https://rksv.fiskaly.com/api/v1",
        "ApiKey": "",
        "ApiSecret": ""
      },
      "epson": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      },
      "swissbit": {
        "Enabled": false,
        "ApiBaseUrl": "",
        "ApiKey": "",
        "ApiSecret": ""
      }
    },
    "FallbackEnabled": true,
    "SoftTseEnabled": true,
    "AllowSimulatedDailyClosing": true,
    "OfflineModeEnabled": true,
    "MaxOfflineTransactionsPerCashRegister": 999999
  },
  "FinanzOnline": {
    "_comment": "UseSimulation=true is intentional for Development. Production must set all UseSimulation=false.",
    "Mode": "Simulation",
    "Session": {
      "UseSimulation": true
    },
    "Registrierkassen": {
      "UseSimulation": true,
      "EnableRealTestSubmission": false
    },
    "TransmissionQuery": {
      "UseSimulation": true,
      "EnableRealTestQuery": false
    },
    "RksvSubmission": {
      "ClientKind": "Fake",
      "Enabled": false
    }
  },
  "FinanzOnlineOutbox": {
    "Enabled": false
  },
  "FinanzOnlineRetryJob": {
    "Enabled": false
  },
  "License": {
    "GracePeriodDays": 7,
    "WarningDaysBeforeExpiry": 14,
    "ArchiveAfterDays": 30,
    "RequireMachineBinding": false,
    "SigningPrivateKeyPem": null,
    "OfflineVerificationPublicKeyPem": null
  },
  "LicenseSettings": {
    "PublicKeyPath": "App_Data/license-dev/verification-public.pem",
    "PrivateKeyPath": "App_Data/license-dev/signing-private.pem"
  },
  "CashRegister": {
    "AllowHardDelete": false
  },
  "Backup": {
    "_comment": "Fake mode — no real pg_dump. Development only (manifest may show phase 1 / no real pg_dump). For real dumps see backend/docs/BACKUP_DEVELOPMENT_REAL_PG_DUMP.md or run scripts/test-real-backup.ps1 (user-secrets: Backup:ExecutionAdapterKind=PgDump).",
    "WorkerEnabled": true,
    "ExecutionAdapterKind": "Fake",
    "ArtifactStagingRoot": null,
    "LogicalDumpConnectionStringName": "DefaultConnection",
    "PgDumpExecutablePath": null,
    "ExternalArchiveRoot": null
  },
  "RestoreVerification": {
    "PgRestoreExecutablePath": null
  },
  "Inventory": {
    "EnforceStockOnSales": false
  },
  "NtpSettings": {
    "Enabled": false,
    "DevelopmentBypass": true,
    "SyncIntervalMinutes": 15,
    "MaxAllowedOffsetSeconds": 30,
    "CriticalOffsetSeconds": 60,
    "NtpServers": ["time.google.com", "pool.ntp.org", "at.pool.ntp.org"]
  },
  "DevelopmentOptions": {
    "SimulateTseUnavailable": false,
    "SimulateNtpFailure": false,
    "SimulateLicenseExpired": false
  },
  "PaymentGateway": {
    "Provider": "Mock",
    "RequireCardIntentForPosPayments": false,
    "SimulateDelayMs": 500,
    "Stripe": {
      "ApiKey": "",
      "WebhookSecret": ""
    }
  },
  "ShiftAutoClose": {
    "Enabled": true,
    "MaxOpenDurationHours": 12,
    "CheckIntervalMinutes": 60
  },
  "Email": {
    "DevCapture": {
      "Enabled": true,
      "Directory": "App_Data/dev-mail"
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "From": "",
      "SupportContact": "support@regkasse.local"
    }
  },
  "Monitoring": {
    "Enabled": true,
    "MetricsEndpoint": "/metrics",
    "SlowRequestThresholdMs": 1000,
    "Prometheus": {
      "Enabled": true,
      "ScrapeIntervalSeconds": 15
    }
  }
}
